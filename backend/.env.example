# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
APP_NAME="Inventory AI Assistant"
ENVIRONMENT=development
DEBUG=true

# ==========================================
# INVENTORY API SETTINGS
# ==========================================
INVENTORY_API_BASE_URL=https://api.inventory.indianrailwayads.com/api
INVENTORY_ACCESS_TOKEN=
INVENTORY_API_TIMEOUT=30.0

# ==========================================
# LLM / GEMINI AI CONFIGURATION
# ==========================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOW_DEBUG_LOGGING=false

# ==========================================
# CHATBOT TUNING
# ==========================================
CHAT_MAX_HISTORY=20
CHATBOT_NAME="Inventory AI Assistant"

# ==========================================
# EMAIL / SMTP CONFIGURATION
# ==========================================
# Recipient email where support/issue reports will be delivered
REPORT_RECIPIENT_EMAIL=support@company.com

# Active email profile to use (e.g., 'company' or 'gmailmain' or leave empty for default)
EMAIL_DEFAULT_PROFILE=company
EMAIL_PROFILES=company,gmailmain

# --- OPTION 1: Company SMTP Server (Default) ---
EMAIL_HOST=mail.company.com
EMAIL_PORT=465
EMAIL_USER=support@company.com
EMAIL_PASSWORD=your_company_email_password
EMAIL_FROM=support@company.com
EMAIL_SECURE=true

# Named Company Profile (Matches EMAIL_DEFAULT_PROFILE=company)
EMAIL_COMPANY_HOST=mail.company.com
EMAIL_COMPANY_PORT=465
EMAIL_COMPANY_USER=support@company.com
EMAIL_COMPANY_PASSWORD=your_company_email_password
EMAIL_COMPANY_FROM=support@company.com
EMAIL_COMPANY_SECURE=true

# --- OPTION 2: Gmail SMTP Server (Alternative) ---
# To use Gmail: Set EMAIL_DEFAULT_PROFILE=gmailmain and generate a 16-character Google App Password
EMAIL_GMAILMAIN_HOST=smtp.gmail.com
EMAIL_GMAILMAIN_PORT=587
EMAIL_GMAILMAIN_USER=your_email@gmail.com
EMAIL_GMAILMAIN_PASSWORD=your_16_char_google_app_password
EMAIL_GMAILMAIN_FROM=your_email@gmail.com
EMAIL_GMAILMAIN_SECURE=false
