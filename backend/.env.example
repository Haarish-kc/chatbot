# Application
APP_NAME="Inventory AI Assistant"
ENVIRONMENT=development
DEBUG=true

# Inventory API
INVENTORY_API_BASE_URL=https://api.inventory.indianrailwayads.com/api
INVENTORY_ACCESS_TOKEN=
INVENTORY_API_TIMEOUT=30.0

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_API_KEY=

# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Chatbot
CHAT_MAX_HISTORY=20
CHATBOT_NAME="Inventory AI Assistant"

# Security
ALLOW_DEBUG_LOGGING=false
